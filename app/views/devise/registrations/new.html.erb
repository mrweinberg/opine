<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-warm-white rounded-2xl border border-sand p-8">
    <div class="text-center mb-8">
      <h2 class="font-heading text-3xl font-bold text-espresso">Create your account</h2>
      <p class="text-walnut mt-2">Join Opine and start reviewing</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <% if resource.errors.any? %>
        <div class="bg-parchment border border-clay/30 text-walnut px-4 py-3 rounded-lg mb-6 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <%= f.label :username, class: "block text-sm font-medium text-walnut mb-1" %>
          <%= f.text_field :username, autofocus: true, autocomplete: "username",
              class: "w-full px-4 py-3 bg-warm-white border border-sand rounded-xl focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-clay transition",
              placeholder: "Choose a username" %>
          <p class="mt-1 text-xs text-walnut/70">3-20 characters, letters, numbers, and underscores only</p>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-walnut mb-1" %>
          <%= f.email_field :email, autocomplete: "email",
              class: "w-full px-4 py-3 bg-warm-white border border-sand rounded-xl focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-clay transition",
              placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-walnut mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full px-4 py-3 bg-warm-white border border-sand rounded-xl focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-clay transition",
              placeholder: "••••••••" %>
          <% if @minimum_password_length %>
            <p class="mt-1 text-xs text-walnut/70"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-walnut mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-4 py-3 bg-warm-white border border-sand rounded-xl focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-clay transition",
              placeholder: "••••••••" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Create account", class: "w-full bg-terracotta hover:bg-terracotta-dark text-white font-semibold py-3 px-4 rounded-xl transition cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <% if devise_mapping.omniauthable? && resource_class.omniauth_providers.any? %>
      <div class="mt-6">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-sand"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-4 bg-warm-white text-walnut">or sign up with</span>
          </div>
        </div>

        <div class="mt-4 space-y-3">
          <% resource_class.omniauth_providers.each do |provider| %>
            <%= link_to omniauth_authorize_path(resource_name, provider),
                method: :post,
                class: "w-full flex items-center justify-center gap-3 px-4 py-3 border-2 border-sand rounded-xl hover:bg-parchment hover:border-clay/40 transition font-medium text-walnut" do %>
              <% if provider == :google_oauth2 %>
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Sign up with Google
              <% else %>
                Sign up with <%= OmniAuth::Utils.camelize(provider) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 text-center text-sm text-walnut">
      Already have an account?
      <%= link_to "Sign in", new_user_session_path, class: "text-clay hover:text-espresso font-semibold transition" %>
    </div>
  </div>
</div>
