<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-warm-white rounded-2xl border border-sand p-8">
    <div class="text-center mb-8">
      <h2 class="font-heading text-3xl font-bold text-espresso">Reset your password</h2>
      <p class="text-walnut mt-2">Enter your email and we'll send you a reset link</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <% if resource.errors.any? %>
        <div class="bg-parchment border border-clay/30 text-walnut px-4 py-3 rounded-lg mb-6 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-walnut mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-4 py-3 bg-warm-white border border-sand rounded-xl focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-clay transition",
              placeholder: "you@example.com" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Send reset instructions", class: "w-full bg-terracotta hover:bg-terracotta-dark text-white font-semibold py-3 px-4 rounded-xl transition cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 text-center text-sm text-walnut space-y-2">
      <div>
        Remember your password?
        <%= link_to "Sign in", new_user_session_path, class: "text-clay hover:text-espresso font-semibold transition" %>
      </div>
      <div>
        Don't have an account?
        <%= link_to "Sign up", new_user_registration_path, class: "text-clay hover:text-espresso font-semibold transition" %>
      </div>
    </div>
  </div>
</div>
