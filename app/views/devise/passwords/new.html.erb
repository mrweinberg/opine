<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-white rounded-2xl shadow-lg p-8">
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900">Reset your password</h2>
      <p class="text-gray-500 mt-2">Enter your email and we'll send you a reset link</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <% if resource.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-5">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition",
              placeholder: "you@example.com" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Send reset instructions", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition cursor-pointer shadow-sm hover:shadow-md" %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 text-center text-sm text-gray-600 space-y-2">
      <div>
        Remember your password?
        <%= link_to "Sign in", new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-semibold" %>
      </div>
      <div>
        Don't have an account?
        <%= link_to "Sign up", new_user_registration_path, class: "text-blue-600 hover:text-blue-800 font-semibold" %>
      </div>
    </div>
  </div>
</div>
