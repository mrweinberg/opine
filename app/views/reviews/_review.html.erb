<%= turbo_frame_tag dom_id(review) do %>
  <div class="bg-warm-white rounded-lg border border-sand p-4 mb-4" id="<%= dom_id(review) %>">
    <div class="flex justify-between items-start">
      <div class="flex items-center gap-3">
        <div class="text-xl font-bold font-heading w-12 h-12 rounded-full flex items-center justify-center text-white <%= score_bg_class(review.score) %>">
          <%= review.score %>
        </div>
        <div>
          <div class="font-semibold text-espresso">
            <%= review.user.display_name || review.user.username %>
          </div>
          <div class="text-xs text-walnut/60">
            <%= time_ago_in_words(review.created_at) %> ago
          </div>
        </div>
      </div>

      <% if user_signed_in? %>
        <div class="flex gap-2">
          <% if policy(review).update? %>
            <%= link_to "Edit", edit_item_review_path(review.item, review),
                class: "text-sm text-walnut hover:text-clay transition",
                data: { turbo_frame: dom_id(review) } %>
          <% end %>
          <% if policy(review).destroy? %>
            <%= button_to "Delete", item_review_path(review.item, review),
                method: :delete,
                data: { turbo_confirm: "Delete this review?" },
                class: "text-sm text-walnut hover:text-score-1 transition" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if review.body.present? %>
      <p class="text-walnut mt-3"><%= review.body %></p>
    <% end %>

    <% if review.images.attached? %>
      <div class="flex gap-2 mt-3 overflow-x-auto">
        <% review.images.each do |image| %>
          <%= image_tag image, class: "w-20 h-20 object-cover rounded" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
