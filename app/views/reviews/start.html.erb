<div class="max-w-2xl mx-auto py-8 px-4" 
     data-controller="review-flow"
     data-review-flow-category-map-value="<%= Item::CATEGORY_MAP.to_json %>"
     data-review-flow-attribute-definitions-value="<%= Item::ATTRIBUTE_DEFINITIONS.to_json %>"
     data-review-flow-identifier-fields-value="<%= Item::IDENTIFIER_FIELD.to_json %>">
     
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Add a Review</h1>

  <!-- Step 1: Category Selection -->
  <div data-review-flow-target="step1" class="transition-all duration-300">
    <label class="block text-lg font-medium text-gray-700 mb-4">Pick a category</label>
    <div class="grid grid-cols-3 gap-4">
      <% Item::CATEGORY_MAP.each_key do |category| %>
        <button type="button"
                class="p-6 border-2 rounded-xl hover:border-blue-500 hover:bg-blue-50 text-center transition group"
                data-action="click->review-flow#selectCategory"
                value="<%= category %>">
          <span class="text-xl font-semibold text-gray-900 block pointer-events-none group-hover:text-blue-700"><%= category %></span>
          <span class="text-sm text-gray-500 block mt-1 pointer-events-none"><%= Item::CATEGORY_MAP[category].count %> types</span>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Step 2: Subcategory Selection -->
  <div data-review-flow-target="step2" class="hidden transition-all duration-300">
    <div class="flex items-center gap-2 mb-4">
      <button type="button" class="text-gray-500 hover:text-gray-900" 
              data-action="click->review-flow#goToStep" 
              data-review-flow-step-param="1">← Back</button>
      <label class="text-lg font-medium text-gray-700">
        What kind of <span data-review-flow-target="categoryLabel" class="text-blue-600"></span>?
      </label>
    </div>
    <div data-review-flow-target="subcategoryButtons" class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <%# Filled by Stimulus %>
    </div>
  </div>

  <!-- Step 3: Search / Autocomplete -->
  <div data-review-flow-target="step3" class="hidden transition-all duration-300">
    <div class="flex items-center gap-2 mb-4">
      <button type="button" class="text-gray-500 hover:text-gray-900" 
              data-action="click->review-flow#goToStep" 
              data-review-flow-step-param="2">← Back</button>
      <label class="text-lg font-medium text-gray-700">
        Name the <span data-review-flow-target="subcategoryLabel" class="text-blue-600"></span>
      </label>
    </div>

    <div class="relative">
      <input type="text" 
             data-review-flow-target="searchInput"
             data-action="input->review-flow#search"
             placeholder="Start typing..." 
             class="w-full text-lg p-4 rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
             autocomplete="off">
      
      <!-- Autocomplete Dropdown -->
      <div data-review-flow-target="searchResults" 
           class="absolute top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl z-50 hidden max-h-64 overflow-y-auto">
      </div>
    </div>
  </div>

  <!-- Step 4: Form Container -->
  <div data-review-flow-target="step4" class="hidden transition-all duration-300">
    <div class="mb-6">
      <button type="button" class="text-gray-500 hover:text-gray-900" 
              data-action="click->review-flow#goToStep" 
              data-review-flow-step-param="3">← Back to Search</button>
    </div>

    <!-- Existing Item Form -->
    <div data-review-flow-target="existingItemForm" class="hidden">
      <div data-review-flow-target="existingItemHeader" class="bg-gray-50 rounded-lg p-4 mb-6">
        <%# Filled by Stimulus with item name + identifier %>
      </div>
      <%= form_with model: @review, url: "", local: true, method: :post do |f| %>
        <%= render "form_fields", f: f %>
        <div class="mt-6">
          <%= f.submit "Post Review", class: "w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <!-- New Item Form -->
    <div data-review-flow-target="newItemForm" class="hidden">
      <h2 class="text-xl font-bold mb-4">Create & Review New Item</h2>
      <%= form_with model: @new_item, url: items_path, local: true do |f| %>
        <div data-review-flow-target="itemFields" class="bg-gray-50 p-4 rounded-lg mb-6 space-y-4">
          <div>
            <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, readonly: true, class: "w-full bg-gray-100 rounded-lg border-gray-300 text-gray-500" %>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :category, readonly: true, class: "w-full bg-gray-100 rounded-lg border-gray-300 text-gray-500" %>
            </div>
            <div>
              <%= f.label :subcategory, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :subcategory, readonly: true, class: "w-full bg-gray-100 rounded-lg border-gray-300 text-gray-500" %>
            </div>
          </div>

          <!-- Dynamic Metadata Container -->
          <div data-review-flow-target="metadataContainer" class="grid grid-cols-2 gap-4">
            <!-- Injected by Stimulus -->
          </div>
        </div>

        <h3 class="text-lg font-medium mb-4">Your Review</h3>
        <%= f.fields_for :reviews do |rf| %>
          <%= render "form_fields", f: rf %>
        <% end %>

        <div class="mt-6">
          <%= f.submit "Create Item & Post Review", class: "w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

</div>
