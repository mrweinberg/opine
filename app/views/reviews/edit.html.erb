<div class="max-w-xl mx-auto py-8 px-4">
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h1 class="text-xl font-bold text-gray-900 mb-4">Edit Review</h1>
    <p class="text-gray-600 mb-4">for <%= @item.name %></p>

    <%= render "form", item: @item, review: @review %>

    <div class="mt-4">
      <%= link_to "Cancel", @item, class: "text-gray-500 hover:text-gray-700" %>
    </div>
  </div>
</div>
