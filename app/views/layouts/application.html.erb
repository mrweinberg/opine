<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Opine" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Opine">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Rate and review Places, Experiences, and Things">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-cream font-body text-espresso min-h-screen">
    <nav class="bg-warm-white border-b border-sand">
      <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
        <%= link_to "Opine", root_path, class: "font-heading text-2xl font-bold text-espresso tracking-tight" %>
        <div class="flex items-center gap-4">
          <% if user_signed_in? %>
            <span class="text-walnut text-sm">
              <%= current_user.display_name || current_user.username %>
            </span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                class: "text-sm text-walnut hover:text-espresso transition" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm text-walnut hover:text-espresso transition" %>
            <%= link_to "Sign up", new_user_registration_path,
                class: "text-sm bg-terracotta hover:bg-terracotta-dark text-white px-3 py-1.5 rounded-lg transition font-medium" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if alert.present? %>
      <div class="max-w-4xl mx-auto px-4 mt-4">
        <div class="bg-parchment border border-clay/30 text-walnut px-4 py-3 rounded-lg">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <% if notice.present? %>
      <div class="max-w-4xl mx-auto px-4 mt-4">
        <div class="bg-parchment border border-score-6/30 text-walnut px-4 py-3 rounded-lg">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <main class="mt-8">
      <%= yield %>
    </main>
  </body>
</html>
