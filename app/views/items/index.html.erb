<div class="max-w-4xl mx-auto py-8 px-4">
  <!-- Header -->
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="font-heading text-3xl font-bold text-espresso">Opine</h1>
      <p class="text-walnut mt-1">Rate places, experiences, and things.</p>
    </div>
    <% if user_signed_in? %>
      <%= link_to "Add Review", new_review_wizard_path, class: "bg-terracotta hover:bg-terracotta-dark text-white font-semibold py-2 px-4 rounded-lg transition" %>
    <% end %>
  </div>

  <!-- Category cards -->
  <% Item::CATEGORY_MAP.each do |category, subcategories| %>
    <div class="mb-6">
      <h2 class="font-heading text-lg font-semibold text-espresso mb-3"><%= category %></h2>
      <div class="flex flex-wrap gap-3">
        <% subcategories.each do |sub| %>
          <%= link_to sub, subcategory_path_for(sub),
              class: "bg-warm-white border border-sand rounded-lg px-4 py-2 text-walnut hover:border-clay/40 hover:text-clay transition font-medium text-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Recent reviews -->
  <div class="mt-10">
    <h2 class="font-heading text-lg font-semibold text-espresso mb-4">Recent Reviews</h2>
    <div class="grid gap-4">
      <% @recent_reviews.each do |review| %>
        <%= render "subcategories/review_card", review: review %>
      <% end %>
      <% if @recent_reviews.empty? %>
        <p class="text-center text-walnut py-8">No reviews yet.</p>
      <% end %>
    </div>
  </div>
</div>
