<div class="max-w-4xl mx-auto py-8 px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Items</h1>
    <% if user_signed_in? %>
      <%= link_to "New Item", new_item_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition" %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
      <%= notice %>
    </div>
  <% end %>

  <div class="grid gap-4">
    <% @items.each do |item| %>
      <div class="bg-white rounded-lg shadow p-6 hover:shadow-md transition">
        <div class="flex justify-between items-start">
          <div>
            <%= link_to item.name, item, class: "text-xl font-semibold text-gray-900 hover:text-blue-600" %>
            <div class="text-sm text-gray-500 mt-1">
              <span class="bg-gray-100 px-2 py-1 rounded"><%= item.category %></span>
              <span class="bg-gray-100 px-2 py-1 rounded ml-1"><%= item.subcategory %></span>
            </div>
          </div>
          <% if item.average_score.present? %>
            <div class="text-2xl font-bold text-blue-600">
              <%= number_with_precision(item.average_score, precision: 1) %>
            </div>
          <% end %>
        </div>
        <% if item.ai_summary.present? %>
          <p class="text-gray-600 mt-3 text-sm"><%= truncate(item.ai_summary, length: 150) %></p>
        <% end %>
        <div class="text-xs text-gray-400 mt-3">
          Added by <%= item.created_by_user&.display_name || item.created_by_user&.username || "Unknown" %>
        </div>
      </div>
    <% end %>

    <% if @items.empty? %>
      <div class="text-center py-12 text-gray-500">
        <p class="text-lg">No items yet.</p>
        <% if user_signed_in? %>
          <p class="mt-2"><%= link_to "Create the first one!", new_item_path, class: "text-blue-600 hover:underline" %></p>
        <% else %>
          <p class="mt-2"><%= link_to "Sign in", new_user_session_path, class: "text-blue-600 hover:underline" %> to add items.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
