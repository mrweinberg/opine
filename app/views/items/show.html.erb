<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="bg-warm-white rounded-lg border border-sand p-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="font-heading text-3xl font-bold text-espresso"><%= @item.name %></h1>
        <% if @item.identifier_value.present? %>
          <p class="text-lg text-walnut mt-1">
            <% @item.identifier_fields.each_with_index do |field, i| %>
              <% val = @item.metadata&.dig(field.to_s) %>
              <% if val.present? %>
                <% if i > 0 %> · <% end %>
                <span class="text-walnut/70"><%= field.to_s.humanize.titleize %>:</span> <%= val %>
              <% end %>
            <% end %>
          </p>
        <% end %>
        <div class="text-sm text-walnut mt-2">
          <span class="bg-parchment px-2 py-1 rounded"><%= @item.category %></span>
          <span class="bg-parchment px-2 py-1 rounded ml-1"><%= @item.subcategory %></span>
        </div>
      </div>
      <div id="item_score" class="text-center">
        <% if @item.average_score.present? %>
          <div class="font-heading text-4xl font-bold <%= score_text_class(@item.average_score.round) %>">
            <%= number_with_precision(@item.average_score, precision: 1) %>
          </div>
          <div class="text-xs text-walnut/60"><%= pluralize(@item.reviews_count, "review") %></div>
        <% else %>
          <div class="text-sm text-walnut/50">No reviews yet</div>
        <% end %>
      </div>
    </div>

    <% if @item.ai_summary.present? %>
      <div class="bg-parchment rounded-lg p-4 mb-6">
        <div class="text-xs text-clay font-semibold mb-1">✨ AI Summary</div>
        <p class="text-walnut"><%= @item.ai_summary %></p>
      </div>
    <% end %>

    <% if @item.metadata.present? && @item.metadata.any? %>
      <div class="border-t border-sand pt-4 mb-6">
        <h3 class="text-sm font-semibold text-walnut/70 mb-3">Details</h3>
        <dl class="grid grid-cols-2 gap-2 text-sm">
          <% @item.metadata.each do |key, value| %>
            <dt class="text-walnut/70 capitalize"><%= key.to_s.humanize %></dt>
            <dd class="text-espresso"><%= value %></dd>
          <% end %>
        </dl>
      </div>
    <% end %>

    <div class="flex gap-3 pt-4 border-t border-sand">
      <%= link_to "← Back", items_path, class: "text-walnut hover:text-espresso transition" %>

      <% if user_signed_in? && policy(@item).update? %>
        <%= link_to "Edit", edit_item_path(@item), class: "text-clay hover:underline" %>
      <% end %>

      <% if user_signed_in? && policy(@item).destroy? %>
        <%= button_to "Delete", @item, method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "text-score-1 hover:underline" %>
      <% end %>
    </div>

    <div class="text-xs text-walnut/50 mt-6">
      Added by <%= @item.created_by_user&.display_name || @item.created_by_user&.username || "Unknown" %>
      on <%= @item.created_at.strftime("%B %d, %Y") %>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="mt-8">
    <h2 class="font-heading text-xl font-bold text-espresso mb-4">Reviews</h2>

    <% if user_signed_in? %>
      <% existing_review = @item.reviews.find_by(user: current_user) %>
      <% if existing_review.nil? %>
        <%= render "reviews/form", item: @item, review: @item.reviews.build %>
      <% else %>
        <div class="bg-parchment rounded-lg p-4 mb-4 text-sm text-walnut">
          You've already reviewed this item.
          <%= link_to "Edit your review", edit_item_review_path(@item, existing_review), 
              class: "text-clay hover:underline",
              data: { turbo_frame: dom_id(existing_review) } %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-parchment rounded-lg p-4 mb-4 text-center text-walnut">
        <%= link_to "Sign in", new_user_session_path, class: "text-clay hover:underline" %> to leave a review.
      </div>
    <% end %>

    <div id="reviews" class="mt-6">
      <%= render @item.reviews.includes(:user).recent %>
    </div>

    <% if @item.reviews.empty? %>
      <p class="text-walnut/60 text-center py-8 font-heading italic">No reviews yet. Be the first!</p>
    <% end %>
  </div>
</div>
